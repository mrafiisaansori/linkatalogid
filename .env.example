# URL backend PHP REST API. Wajib di-set di Vercel.
BACKEND_URL="https://linkatalog.raftechsolution.web.id"
BACKEND_AUTH_USER="your-backend-basic-auth-user"
BACKEND_AUTH_PASS="your-backend-basic-auth-password"

# Wajib di production. Generate random panjang (mis. `openssl rand -hex 48`).
LINKATALOG_SESSION_SECRET="opsional-tapi-disarankan-random-panjang"

# Opsional: paksa mode demo read-only (block sign-up via runtime flag).
# LINKATALOG_DEMO_MODE="1"

# Cloudflare Turnstile. Site key bersifat publik, secret key hanya dipakai di
# server untuk verifikasi token. Ambil dari Cloudflare dashboard → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
