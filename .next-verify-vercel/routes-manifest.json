      "page": "/api/admin/users/[id]/status",
      "regex": "^/api/admin/users/([^/]+?)/status(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/users/(?<nxtPid>[^/]+?)/status(?:/)?$"
    },
    {
      "page": "/api/me/products/[id]",
      "regex": "^/api/me/products/([^/]+?)(?:/)?$",
